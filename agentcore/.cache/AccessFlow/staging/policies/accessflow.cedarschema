// ============================================================================
// AccessFlow Cedar Schema
//
// This schema validates policies at load time. A typo in an action name or
// context attribute fails at startup, not as a mysterious runtime denial.
//
// Cedar silently skips erroring policies during evaluation. The schema is
// the first line of defense against silent failures.
//
// NOTE: No namespace used to match the existing policies which use
// Action::"tool_name" without a namespace prefix.
// ============================================================================

// ---------------------------------------------------------------------------
// Entity types
// ---------------------------------------------------------------------------

entity Coordinator;

entity Case;

entity Resource;


// ---------------------------------------------------------------------------
// Context shape — the attributes Cedar policies may reference
// ---------------------------------------------------------------------------

type SessionContext = {
    verification_passed?: Bool,
    reminders_sent_24h?: Long,
    hours_since_request?: Long,
    call_count?: Long,
    role?: String,
    org_id?: String,
    case_state?: String,
};

type InputContext = {
    idempotency_key?: String,
    provider_approved?: Bool,
    replacement_approved?: Bool,
    substitution_policy_permits?: Bool,
    comparable_service_confirmed?: Bool,
    decision_id?: String,
    verification_id?: String,
    based_on_verified_state?: Bool,
    asserts_noncompliance?: Bool,
    publishes_externally?: Bool,
    evidence_id?: String,
};

type AuthorizationContext = {
    session?: SessionContext,
    input?: InputContext,
};


// ---------------------------------------------------------------------------
// Actions — every tool that Cedar authorizes
// ---------------------------------------------------------------------------

// Read-only information gathering — always safe
action get_case appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action get_event appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action search_providers appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action check_provider_availability appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action check_provider_response appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action get_material_accessibility_status appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action fetch_agenda_document appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

// Coordination actions — gated on idempotency key
action create_case appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action update_case appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action update_event_notes appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action send_provider_request appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action send_reminder appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action verify_fulfillment appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action record_event_change appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

// Human decision actions
action request_human_decision appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action apply_human_decision appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

// Actions requiring conditions
action replace_provider appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action choose_accommodation_mode appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

// Blocked actions
action close_case appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action override_policy appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action record_material_finding appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

// Additional tools from case_tools.py
action poll_public_meetings appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action derive_obligations appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};

action extract_accommodation_policy appliesTo {
    principal: [Coordinator],
    resource: [Resource],
    context: AuthorizationContext,
};
